default_platform(:ios)

platform :ios do
  desc "Build signe + upload vers TestFlight"
  lane :beta do
    # Trousseau temporaire propre pour la CI
    setup_ci

    # Authentification a App Store Connect via cle API (.p8 decode en fichier par le workflow)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    # match : recupere (ou cree au 1er run) LE certificat de distribution + profil App Store,
    # stockes chiffres dans le repo prive aura-match-certs. Reutilise a chaque run.
    match(
      type: "appstore",
      api_key: api_key,
      git_url: "git@github.com:arcomyxx/aura-match-certs.git",
      app_identifier: "com.dubois.aura",
      readonly: false
    )

    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["com.dubois.aura"]

    # Signature manuelle UNIQUEMENT sur la cible de l'app (pas sur les pods Firebase/gRPC,
    # qui ne supportent pas de profil de provisioning).
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "iosApp.xcodeproj",
      targets: ["iosApp"],
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          "com.dubois.aura" => profile_name
        }
      }
    )

    # Note de version pour le champ "What to Test" (obligatoire en externe).
    # Reprend le sujet du dernier commit, avec repli sur le numero de build.
    build_notes = begin
      last_git_commit[:message].to_s.split("\n").first
    rescue StandardError
      "Build #{ENV['BUILD_NUMBER']}"
    end

    upload_to_testflight(
      api_key: api_key,
      # Attend la fin du traitement Apple : la CI echoue franchement en cas de
      # rejet, au lieu de "reussir" a vide.
      skip_waiting_for_build_processing: false,
      changelog: build_notes,
      # Distribution automatique : groupe interne + groupe externe.
      groups: ["Famille", "Famille externe"],
      distribute_external: true,
      notify_external_testers: true
    )
  end
end
