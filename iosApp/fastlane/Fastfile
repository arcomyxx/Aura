default_platform(:ios)

platform :ios do
  desc "Build signe + upload vers TestFlight"
  lane :beta do
    # Trousseau temporaire propre pour la CI
    setup_ci

    # Authentification a App Store Connect via cle API (.p8 decode en fichier par le workflow)
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    # match : recupere (ou cree au 1er run) LE certificat de distribution + profil App Store,
    # stockes chiffres dans le repo prive aura-match-certs. Reutilise a chaque run -> plus
    # jamais d'epuisement de certificats.
    match(
      type: "appstore",
      api_key: api_key,
      git_url: "git@github.com:arcomyxx/aura-match-certs.git",
      app_identifier: "com.dubois.aura",
      readonly: false
    )

    # UUID du profil installe par match (sans espace -> sur en xcargs)
    profile_uuid = ENV["sigh_com.dubois.aura_appstore"]
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["com.dubois.aura"]

    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      xcargs: [
        "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
        "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=\"Apple Distribution\"",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid}"
      ].join(" "),
      export_options: {
        signingStyle: "manual",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          "com.dubois.aura" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
