rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profils utilisateurs : lisibles par tout utilisateur connecté
    // (nécessaire pour la recherche par nom/email), modifiables seulement
    // par leur propriétaire.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;

      // Le propriétaire modifie librement son profil. Les autres utilisateurs
      // connectés ne peuvent modifier QUE le champ `auraScore` (mécanique de
      // signalement d'événements entre amis).
      allow update: if request.auth != null && (
                      request.auth.uid == userId
                      || request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['auraScore'])
                    );

      // Sous-collection des amis. Le propriétaire lit sa propre liste.
      // L'écriture est permise aux deux parties concernées : lors de
      // l'acceptation, chacun écrit dans la liste de l'autre.
      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null
                     && (request.auth.uid == userId || request.auth.uid == friendId);
      }

      // Événements d'aura reçus par l'utilisateur. Lisibles par tout membre
      // connecté ; créés par un tiers (auteur = appelant, ≠ cible).
      // Seul l'auteur peut modifier ou supprimer son propre signalement, sans
      // pouvoir en changer l'auteur ni la cible.
      match /events/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorUid == request.auth.uid
                      && request.auth.uid != userId;
        allow update: if request.auth != null
                      && resource.data.authorUid == request.auth.uid
                      && request.resource.data.authorUid == resource.data.authorUid
                      && request.resource.data.targetUid == resource.data.targetUid;
        allow delete: if request.auth != null
                      && resource.data.authorUid == request.auth.uid;
      }
    }

    // Battles d'aura. L'hôte crée sa battle (score à 0) puis la clôture
    // (status + auraAwarded uniquement). Les autres membres ne font
    // qu'incrémenter les compteurs tant qu'elle est en cours, avec une marge
    // de 5 s après `endsAt` pour les derniers envois, et un plafond par écriture.
    match /battles/{battleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.status == 'live'
                    && request.resource.data.score == 0;
      allow update: if request.auth != null && (
                      (request.auth.uid == resource.data.hostUid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'auraAwarded']))
                      || (request.auth.uid != resource.data.hostUid
                        && resource.data.status == 'live'
                        && request.time.toMillis() <= resource.data.endsAt + 5000
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['score', 'taps', 'maxCombo', 'supporterUids'])
                        && request.resource.data.score >= resource.data.score
                        && request.resource.data.score - resource.data.score <= 5000)
                    );

      // Contribution de chaque supporter : il n'écrit que la sienne, pendant
      // la battle, et jamais sur sa propre battle.
      match /supporters/{supporterId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && request.auth.uid == supporterId
                     && get(/databases/$(database)/documents/battles/$(battleId)).data.hostUid != request.auth.uid
                     && get(/databases/$(database)/documents/battles/$(battleId)).data.status == 'live'
                     && request.time.toMillis() <= get(/databases/$(database)/documents/battles/$(battleId)).data.endsAt + 5000;
      }
    }

    // Demandes d'ami : lisibles/modifiables uniquement par l'expéditeur
    // ou le destinataire. La création exige que fromUid soit l'appelant.
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid == request.auth.uid);
    }
  }
}
